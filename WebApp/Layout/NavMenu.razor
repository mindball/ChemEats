<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="">
            <img src="https://www.cpachem.com/_custom/_cpachem.com/images/logo-a.png" alt="CPAChem" style="height: 28px;" class="me-2" />
            @* <span>@L["ChemEats"]</span> *@
        </a>
        <button title="@L["Navigation menu"]" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>
<div class="@NavMenuCssClass nav-scrollable">
    <nav class="nav flex-column">

        <!-- Always visible -->
        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill me-2 d-inline-flex align-items-center"></span> @L["Dashboard"]
            </NavLink>
        </div>

        <!-- All authenticated users: Browse Menus, Place Order, My Orders -->
        <AuthorizeView>
            <Authorized>

                <div class="nav-item px-3 nav-section-label">
                    <small class="text-uppercase">@L["Lab Menu"]</small>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="menus/view">
                        <span class="bi bi-journal-text me-2 d-inline-flex align-items-center"></span> @L["Browse Menus"]
                    </NavLink>
                </div>

                <div class="nav-item px-3 nav-section-label">
                    <small class="text-uppercase">@L["Orders"]</small>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="menus/order">
                        <span class="bi bi-cart-fill me-2 d-inline-flex align-items-center"></span> @L["Place Order"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="orders/my">
                        <span class="bi bi-receipt me-2 d-inline-flex align-items-center"></span> @L["My Orders"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="orders/obligations">
                        <span class="bi bi-bag me-2 d-inline-flex align-items-center"></span> @L["My Obligations"]
                    </NavLink>
                </div>

                <div class="nav-item px-3 nav-section-label">
                    <small class="text-uppercase">@L["Control Panel"]</small>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="account/change-password">
                        <span class="bi bi-key-fill me-2 d-inline-flex align-items-center"></span> @L["Change Password"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="account/notifications">
                        <span class="bi bi-bell-fill me-2 d-inline-flex align-items-center"></span> @L["Notifications"]
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

        <!-- Supervisor and Admin: Create Menu, Suppliers -->
        <AuthorizeView Roles="Supervisor,Admin">
            <Authorized>

                <div class="nav-item px-3 nav-section-label">
                    <small class="text-uppercase">@L["Management"]</small>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="upload-menu">
                        <span class="bi bi-clipboard-plus me-2 d-inline-flex align-items-center"></span> @L["Create Menu"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="get-suppliers">
                        <span class="bi bi-building me-2 d-inline-flex align-items-center"></span> @L["Suppliers"]
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

        <!-- Admin only: Add Supplier, Control Panel, Payments -->
        <AuthorizeView Roles="Admin">
            <Authorized>

                <div class="nav-item px-3 nav-section-label">
                    <small class="text-uppercase">@L["Administration"]</small>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="register-supplier">
                        <span class="bi bi-plus-circle-fill me-2 d-inline-flex align-items-center"></span> @L["Add Supplier"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="admin">
                        <span class="bi bi-shield-lock-fill me-2 d-inline-flex align-items-center"></span> @L["Control Panel"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="admin/payments">
                        <span class="bi bi-cash-coin me-2 d-inline-flex align-items-center"></span> @L["Payments"]
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}