@page "/admin/payments/summary"
@using Shared.DTOs.Orders
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inherits AdminPaymentsSummaryBase

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0" style="color: #003d61;"><i class="bi bi-cash-coin me-2"></i>Payments</h3>
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link" href="admin/payments"><i class="bi bi-person me-1"></i>By Employee</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="admin/payments/summary"><i class="bi bi-people me-1"></i>Outstanding Summary</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="admin/payments/obligations"><i class="bi bi-bag me-1"></i>Other Obligations</a>
            </li>
        </ul>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">
                <i class="bi bi-funnel me-2"></i>Period (by menu date)
            </h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar-range me-1"></i>Menu date from
                    </label>
                    <input type="date" class="form-control" @bind="StartDate" disabled="@AllDates" />
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="summaryAllDates" @bind="AllDates" />
                        <label class="form-check-label" for="summaryAllDates">All unpaid (ignore dates)</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar-check me-1"></i>Menu date to
                    </label>
                    <input type="date" class="form-control" @bind="EndDate" disabled="@AllDates" />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="LoadSummaryAsync" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="bi bi-search me-2"></i>Search
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
            <button type="button" class="btn-close" @onclick="@(() => ErrorMessage = null)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@SuccessMessage
            <button type="button" class="btn-close" @onclick="@(() => SuccessMessage = null)"></button>
        </div>
    }

    @if (IsLoading && Summaries is null)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (Summaries is not null)
    {
        @if (Summaries.Count > 0)
        {
            <div class="card">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-semibold">
                                <i class="bi bi-people me-2"></i>Employees with unpaid amounts (@Summaries.Count)
                            </span>
                            <span class="ms-2 text-muted outstanding-period">
                                <i class="bi bi-calendar-range me-1"></i>Period: @LoadedPeriodText
                            </span>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" @onclick="OpenPrintReport">
                            <i class="bi bi-printer me-1"></i>Print
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th><i class="bi bi-person me-1"></i>Employee</th>
                                <th class="text-end"><i class="bi bi-list-check me-1"></i>Unpaid Orders</th>
                                <th class="text-end"><i class="bi bi-tag me-1"></i>Gross</th>
                                <th class="text-end"><i class="bi bi-percent me-1"></i>Company Portion</th>
                                <th class="text-end"><i class="bi bi-cash me-1"></i>Balance Owed</th>
                                <th class="text-end"><i class="bi bi-hourglass-split me-1"></i>Earlier</th>
                                <th class="text-end"><i class="bi bi-bag me-1"></i>Other</th>
                                <th class="text-end"><i class="bi bi-wallet2 me-1"></i>Total Due</th>
                                <th class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (EmployeeOutstandingSummaryDto summary in Summaries)
                            {
                                bool isPaying = PayingUserId == summary.UserId;
                                <tr>
                                    <td class="fw-semibold">@summary.EmployeeName</td>
                                    <td class="text-end">@summary.UnpaidCount</td>
                                    <td class="text-end">@FormatEuro(summary.GrossAmount)</td>
                                    <td class="text-end text-success">
                                        @if (summary.PortionAmount > 0)
                                        {
                                            <span>-@FormatEuro(summary.PortionAmount)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold">@FormatEuro(summary.NetAmount)</td>
                                    <td class="text-end">
                                        @if (summary.EarlierUnpaidCount > 0)
                                        {
                                            <span class="text-warning fw-semibold" title="@summary.EarlierUnpaidCount unpaid orders before the period">
                                                @FormatEuro(summary.EarlierNetAmount) (@summary.EarlierUnpaidCount)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (summary.OtherUnpaidCount > 0)
                                        {
                                            <a class="other-obligations-link fw-semibold" href="@OtherObligationsUrl(summary)"
                                               title="@summary.OtherUnpaidCount unpaid other obligations - paid separately">
                                                @FormatEuro(summary.OtherAmount) (@summary.OtherUnpaidCount)
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-danger">@FormatEuro(TotalDue(summary))</td>
                                    <td class="text-center">
                                        @if (HasUnpaidMeals(summary))
                                        {
                                            <button class="btn btn-sm btn-success pay-row-button"
                                                    @onclick="() => PayEmployeeAsync(summary)"
                                                    disabled="@(PayingUserId is not null)">
                                                @if (isPaying)
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-cash-stack me-1"></i><span>Pay</span>
                                                }
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td>Grand Total</td>
                                <td class="text-end">@TotalUnpaidCount</td>
                                <td class="text-end">@FormatEuro(TotalGrossAmount)</td>
                                <td class="text-end text-success">-@FormatEuro(TotalPortionAmount)</td>
                                <td class="text-end">@FormatEuro(TotalNetAmount)</td>
                                <td class="text-end">@FormatEuro(TotalEarlierNetAmount)</td>
                                <td class="text-end">@FormatEuro(TotalOtherAmount)</td>
                                <td class="text-end text-danger fs-5">@FormatEuro(GrandTotalDue)</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="card-footer bg-light small text-muted">
                    <i class="bi bi-info-circle me-1"></i>Only completed orders (finalized menus) are counted; paid, pending, cancelled and deleted orders are excluded. The company portion is applied once per employee per day at payment; unpaid days show the expected portion.
                    "Earlier" is unpaid orders before the start date; "Pay" settles the meals up to the end date.
                    "Other" is unpaid non-food obligations up to the end date; they are paid separately on the Other Obligations page.
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>No unpaid orders up to the end of this period (@LoadedPeriodText).
            </div>
        }
    }
</div>
