@page "/admin"
@using Shared.DTOs.Employees
@using Shared.DTOs.Orders
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inherits WebApp.Pages.AdminPanel.AdminPanelBase

<h3 class="mb-3" style="color: #003d61;"><i class="bi bi-shield-lock-fill me-2"></i>@L["Control Panel"]</h3>

<div class="card mb-3">
    <div class="card-header">
        <strong>@L["Company Portion Settings"]</strong>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">@L["Portion amount (EUR)"]</label>
            <input type="number"
                   class="form-control"
                   step="0.01"
                   min="0"
                   @bind="PortionAmount" />
            <div class="form-text">
                @L["Applied once per menu per user (only the first meal quantity gets the deduction)."]
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync">
                <i class="bi bi-save me-2"></i>@L["Save"]
            </button>
            <button class="btn btn-outline-secondary" @onclick="ResetToDefault">
                @L["Reset to {0:F2}", PortionAmount]
            </button>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success mt-3 mb-0">@SuccessMessage</div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0">@ErrorMessage</div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>@L["Outstanding Payments (all employees, all dates)"]</strong>
        <a class="btn btn-sm btn-outline-primary" href="@AdminPaymentsSummaryBase.AllDatesPageUrl">
            <i class="bi bi-cash-coin me-1"></i>@L["Open Payments"]
        </a>
    </div>
    <div class="card-body">
        @if (OutstandingEmployees is null)
        {
            <div class="text-muted">@L["Loading..."]</div>
        }
        else if (OutstandingEmployees.Count == 0)
        {
            <div class="text-success"><i class="bi bi-check-circle me-1"></i>@L["No unpaid orders."]</div>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3 outstanding-totals">
                <div>
                    <span class="fw-semibold">@L["Total outstanding:"]</span>
                    <span class="text-danger fw-bold">@OutstandingTotalDue.ToString("0.00 €")</span>
                </div>
                <div>
                    <span class="fw-semibold">@L["Unpaid orders:"]</span>
                    <span class="text-danger">@OutstandingOrderCount</span>
                </div>
                <div>
                    <span class="fw-semibold">@L["Employees:"]</span>
                    <span>@OutstandingEmployees.Count</span>
                </div>
            </div>

            <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                <table class="table table-sm table-hover mb-0 align-middle outstanding-table">
                    <thead class="table-light">
                        <tr>
                            <th>@L["Employee"]</th>
                            <th class="text-end">@L["Unpaid Orders"]</th>
                            <th class="text-end">@L["Total Due"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (EmployeeOutstandingSummaryDto summary in OutstandingEmployees)
                        {
                            <tr>
                                <td>@summary.EmployeeName</td>
                                <td class="text-end">@(summary.UnpaidCount + summary.EarlierUnpaidCount)</td>
                                <td class="text-end fw-semibold">@((summary.NetAmount + summary.EarlierNetAmount).ToString("0.00 €"))</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-success" href="@AdminPaymentsBase.EmployeeAllUnpaidPageUrl(summary.UserId)">
                                        <i class="bi bi-cash-stack me-1"></i>@L["Payments"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">
        <strong>@L["Links"]</strong>
    </div>
    <div class="card-body">
        <ul class="list-unstyled mb-0">
            <li class="mb-2">
                <a href="/upload-menu" class="link-primary">
                    <i class="bi bi-file-arrow-up me-2"></i>@L["Upload Menu (CSV)"]
                </a>
            </li>
        </ul>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong><i class="bi bi-people-fill me-2"></i>@L["User Management"]</strong>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadUsersAsync" disabled="@(IsLoadingUsers || IsCreatingEmployee)">
                <i class="bi bi-arrow-clockwise me-1"></i>@L["Refresh"]
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(UserManagementSuccess))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@UserManagementSuccess
                <button type="button" class="btn-close" @onclick="@(() => UserManagementSuccess = null)"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(UserManagementError))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@UserManagementError
                <button type="button" class="btn-close" @onclick="@(() => UserManagementError = null)"></button>
            </div>
        }

        <form class="row g-2 align-items-end mb-3" @onsubmit="CreateEmployeeAsync" @onsubmit:preventDefault>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="new-employee-abbreviation">@L["Abbreviation"]</label>
                <input id="new-employee-abbreviation" class="form-control form-control-sm text-uppercase" maxlength="3"
                       placeholder="@L["e.g. MM"]" @bind="NewEmployeeAbbreviation" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="new-employee-name">@L["Full name"]</label>
                <input id="new-employee-name" class="form-control form-control-sm" maxlength="256" @bind="NewEmployeeFullName" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="new-employee-email">@L["Email (optional)"]</label>
                <input id="new-employee-email" type="email" class="form-control form-control-sm" @bind="NewEmployeeEmail" />
            </div>
            <div class="col-6 col-md-2">
                <button type="submit" class="btn btn-sm btn-success w-100" disabled="@IsCreatingEmployee">
                    <i class="bi bi-person-plus me-1"></i>@L["Add Employee"]
                </button>
            </div>
        </form>

        @if (IsLoadingUsers)
        {
            <div class="d-flex justify-content-center py-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@L["Loading users..."]</span>
                </div>
            </div>
        }
        else if (AllUsers is not null)
        {
            <div class="mb-3">
                <input type="text" class="form-control" placeholder="@L["Search by name, abbreviation or email..."]"
                       @bind="UserSearchTerm" @bind:event="oninput" />
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><i class="bi bi-person me-1"></i>@L["Name"]</th>
                            <th><i class="bi bi-code me-1"></i>@L["Code"]</th>
                            <th><i class="bi bi-envelope me-1"></i>@L["Email"]</th>
                            <th><i class="bi bi-shield me-1"></i>@L["Roles"]</th>
                            <th style="width: 200px"><i class="bi bi-gear me-1"></i>@L["Manage Roles"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (EmployeeDto user in FilteredUsers)
                        {
                            <tr>
                                <td class="fw-semibold">@user.FullName</td>
                                <td>@user.Abbreviation</td>
                                <td><small class="text-muted">@user.Email</small></td>
                                <td>
                                    @foreach (string role in user.Roles)
                                    {
                                        string badgeClass = role switch
                                        {
                                            "Admin" => "bg-danger",
                                            "Supervisor" => "bg-primary",
                                            "Manager" => "bg-info",
                                            _ => "bg-secondary"
                                        };
                                        <span class="badge @badgeClass me-1">
                                            @role
                                            <button type="button" class="btn-close btn-close-white ms-1"
                                                    style="font-size: 0.5rem;"
                                                    @onclick="() => RemoveRoleAsync(user.UserId, role)"
                                                    title="@L["Remove {0}", role]"></button>
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <select class="form-select form-select-sm" id="@($"role-{user.UserId}")">
                                            <option value="">@L["Add role..."]</option>
                                            @foreach (string role in AvailableRoles.Where(r => !user.Roles.Contains(r)))
                                            {
                                                <option value="@role">@role</option>
                                            }
                                        </select>
                                        <button class="btn btn-outline-success btn-sm"
                                                @onclick="async () =>
                                                {
                                                    string? selectedRole = await GetSelectedRoleAsync(user.UserId);
                                                    if (!string.IsNullOrEmpty(selectedRole))
                                                        await AssignRoleAsync(user.UserId, selectedRole);
                                                }">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                        <button class="btn btn-outline-warning btn-sm"
                                                title="@L["Reset to a temporary password"]"
                                                @onclick="() => ResetUserPasswordAsync(user)">
                                            <i class="bi bi-key-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-2 text-muted small">
                <i class="bi bi-info-circle me-1"></i>@L["Showing {0} of {1} users", FilteredUsers.Count, AllUsers.Count]
            </div>
        }
    </div>
</div>