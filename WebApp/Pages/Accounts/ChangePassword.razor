@page "/account/change-password"
@using System.ComponentModel.DataAnnotations
@using Shared.DTOs.Employees
@using WebApp.Services.Employees
@using WebApp.Infrastructure.States
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["Change Password"]</PageTitle>

<h3 class="mb-3" style="color: #003d61;">
    <i class="bi bi-key-fill me-2"></i>@L["Change Password"]
</h3>

@if (RequirePasswordChange)
{
    <div class="alert alert-warning">
        @L["Your current password is temporary. Please set a new password to continue."]
    </div>
}

<p class="text-muted small">@L["At least 8 characters, including a digit and a lowercase letter. It cannot be your abbreviation."]</p>

<EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <label class="form-label">@L["Current password"]</label>
        <InputText class="form-control" type="password" @bind-Value="Model.CurrentPassword" />
        <ValidationMessage For="() => Model.CurrentPassword" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">@L["New password"]</label>
        <InputText class="form-control" type="password" @bind-Value="Model.NewPassword" />
        <ValidationMessage For="() => Model.NewPassword" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">@L["Confirm new password"]</label>
        <InputText class="form-control" type="password" @bind-Value="Model.ConfirmPassword" />
        <ValidationMessage For="() => Model.ConfirmPassword" class="text-danger" />
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit" disabled="@IsSaving">
            <i class="bi bi-save me-1"></i>@L["Save"]
        </button>

        @if (!RequirePasswordChange)
        {
            <button class="btn btn-outline-secondary" type="button" @onclick="GoBack">
                @L["Cancel"]
            </button>
        }
    </div>
</EditForm>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="alert alert-success mt-3">@SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger mt-3">@ErrorMessage</div>
}

@code {
    [Inject] private IEmployeeDataService EmployeeDataService { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "required")]
    private bool RequirePasswordChange { get; set; }

    private ChangePasswordModel Model { get; set; } = new();
    private bool IsSaving { get; set; }
    private string? SuccessMessage { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleSubmitAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        IsSaving = true;

        try
        {
            ChangePasswordRequestDto request = new(
                Model.CurrentPassword,
                Model.NewPassword,
                Model.ConfirmPassword);

            (bool changed, string? error) = await EmployeeDataService.ChangeMyPasswordAsync(request);
            if (!changed)
            {
                ErrorMessage = error ?? L["Password change failed. Please verify your current password."];
                return;
            }

            if (RequirePasswordChange)
            {
                // The current token still carries the must-change-password claim; a fresh login issues a clean one.
                await ((CustomAuthStateProvider)AuthenticationStateProvider).LogoutAsync();
                NavigationManager.NavigateTo("/Account/Login");
                return;
            }

            SuccessMessage = L["Password changed successfully."];
            await Task.Delay(500);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            ErrorMessage = L["Password change failed: {0}", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }

    private sealed class ChangePasswordModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.Required))]
        [Display(Name = nameof(ValidationText.CurrentPassword), ResourceType = typeof(ValidationText))]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.Required))]
        [Display(Name = nameof(ValidationText.NewPassword), ResourceType = typeof(ValidationText))]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.Required))]
        [Display(Name = nameof(ValidationText.ConfirmNewPassword), ResourceType = typeof(ValidationText))]
        [Compare(nameof(NewPassword), ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordsDoNotMatch))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
