[Unit]
Description=ChemEats WebApi
After=network.target firebird.service
Wants=firebird.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/chemeats
ExecStart=/var/www/chemeats/WebApi
EnvironmentFile=/etc/chemeats/chemeats.env
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=chemeats

[Install]
WantedBy=multi-user.target
