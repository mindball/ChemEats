@page "/Account/Login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using WebApp.Infrastructure.States

<PageTitle>@L["Log in"]</PageTitle>

<h1>@L["Log in"]</h1>
<div class="row">
    <div class="col-lg-6">
        <section>
            <StatusMessage Message="@errorMessage" />
            <EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login">
                <DataAnnotationsValidator />
                <h2>@L["Use your username to log in."]</h2>
                <hr />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.UserName" id="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="@L["Username"]" />
                    <label for="Input.UserName" class="form-label">@L["Username"]</label>
                    <ValidationMessage For="() => Input.UserName" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@L["Password"]" />
                    <label for="Input.Password" class="form-label">@L["Password"]</label>
                    <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                        @L["Remember me"]
                    </label>
                </div>
                <div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Log in"]</button>
                </div>
            </EditForm>
        </section>
    </div>
</div>

@inject AuthenticationStateProvider provider
@inject NavigationManager navManager
@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    public async Task LoginAsync()
    {
        CustomAuthStateProvider authStateProvider = (CustomAuthStateProvider)provider;
        CustomAuthStateProvider.FormResult formResult = await authStateProvider.LoginAsync(Input.UserName, Input.Password); // ⬅️ тук също се сменя Email -> UserName

        if (formResult.Succeeded)
        {
            if (formResult.RequiresPasswordChange)
            {
                navManager.NavigateTo("/account/change-password?required=true");
                return;
            }

            navManager.NavigateTo("/");
        }
        else
        {
            errorMessage = formResult.Errors.FirstOrDefault() is { } error ? L[error] : L["Login failed."];
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.Required))]
        [Display(Name = nameof(ValidationText.Username), ResourceType = typeof(ValidationText))]
        public string UserName { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.Required))]
        [Display(Name = nameof(ValidationText.Password), ResourceType = typeof(ValidationText))]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = nameof(ValidationText.RememberMe), ResourceType = typeof(ValidationText))]
        public bool RememberMe { get; set; }
    }
}
