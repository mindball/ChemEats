@page "/reports/menu/{MenuId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@layout PrintLayout
@using Shared.DTOs.Reports
@inherits MenuReportBase

<PageTitle>@DocumentTitle</PageTitle>

<div class="report-toolbar d-print-none">
    <button class="btn btn-outline-secondary" @onclick="GoBack">
        <i class="bi bi-arrow-left me-1"></i>@L["Back"]
    </button>
    <button class="btn btn-primary" @onclick="PrintAsync" disabled="@(Report is null)">
        <i class="bi bi-printer me-1"></i>@L["Print / Save as PDF"]
    </button>
</div>

@if (IsLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading..."]</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger report-message">@ErrorMessage</div>
}
else if (Report is not null)
{
    <article class="report-sheet">
        <h1 class="report-title">@L["Menu Report"] — @Report.SupplierName</h1>

        <section class="report-box report-box-info">
            <div class="report-box-row">
                <span class="report-label">@L["Supplier:"]</span>
                <span>@Report.SupplierName</span>
            </div>
            <div class="report-box-row">
                <span class="report-label">@L["Date:"]</span>
                <span>@Report.MenuDate.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="report-box-row">
                <span class="report-label">@L["Active until:"]</span>
                <span>@Report.ActiveUntil.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
        </section>

        @if (Report.Orders.Count == 0)
        {
            <p class="report-empty">@L["No orders for this menu."]</p>
        }
        else
        {
            <table class="report-table">
                <thead>
                    <tr>
                        <th class="col-index">№</th>
                        <th>@L["Employee"]</th>
                        <th>@L["Meal"]</th>
                        <th class="text-end">@L["Price"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Report.Orders.Count; i++)
                    {
                        MenuReportOrderDto order = Report.Orders[i];
                        <tr>
                            <td class="col-index">@(i + 1)</td>
                            <td>@order.EmployeeName</td>
                            <td>@order.MealName</td>
                            <td class="text-end">@order.Price.ToString("0.00 €")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <section class="report-box report-box-summary">
            <div class="report-box-row">
                <span class="report-label">@L["Total Orders:"]</span>
                <span class="text-end">@Report.Orders.Count</span>
            </div>
            <div class="report-box-row report-total">
                <span class="report-label">@L["Total Amount:"]</span>
                <span class="text-end report-total-amount">@TotalAmount.ToString("0.00 €")</span>
            </div>
        </section>

        @if (MealSummaries.Count > 0)
        {
            <h2 class="report-subtitle">@L["Meals Summary"]</h2>

            <table class="report-table">
                <thead>
                    <tr>
                        <th class="col-index">№</th>
                        <th>@L["Meal"]</th>
                        <th class="text-end">@L["Count"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < MealSummaries.Count; i++)
                    {
                        (string mealName, int count) = MealSummaries[i];
                        <tr>
                            <td class="col-index">@(i + 1)</td>
                            <td>@mealName</td>
                            <td class="text-end">@count бр.</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <footer class="report-footer">
            @L["Generated on"] <strong>@GeneratedAt.ToString("dd.MM.yyyy HH:mm")</strong>
        </footer>
    </article>
}
