@page "/admin/payments"
@using Shared.DTOs.Orders
@using Shared.DTOs.Employees
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inherits AdminPaymentsBase

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0" style="color: #003d61;"><i class="bi bi-cash-coin me-2"></i>Payments</h3>
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="admin/payments"><i class="bi bi-person me-1"></i>By Employee</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="admin/payments/summary"><i class="bi bi-people me-1"></i>Outstanding Summary</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="admin/payments/obligations"><i class="bi bi-bag me-1"></i>Other Obligations</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="admin/payments/obligation-types"><i class="bi bi-tags me-1"></i>Expense Types</a>
            </li>
        </ul>
    </div>

    @if (IsLoading && AllEmployees is null)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="bi bi-funnel me-2"></i>Search Filters
                </h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-person me-1"></i>Employee
                        </label>
                        <input type="text" 
                               class="form-control mb-2" 
                               placeholder="Search employee..."
                               @bind="SearchTerm"
                               @bind:event="oninput" />
                        <select class="form-select" @bind="SelectedUserId" size="5">
                            <option value="">-- Select employee --</option>
                            @foreach (EmployeeDto emp in FilteredEmployees)
                            {
                                <option value="@emp.UserId">
                                    @emp.FullName (@emp.Abbreviation)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-range me-1"></i>Menu date from
                        </label>
                        <input type="date" class="form-control" @bind="StartDate" disabled="@AllDates" />
                        <div class="form-check mt-2">
                            <input type="checkbox" class="form-check-input" id="allDates" @bind="AllDates" />
                            <label class="form-check-label" for="allDates">All unpaid (ignore dates)</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-check me-1"></i>Menu date to
                        </label>
                        <input type="date" class="form-control" @bind="EndDate" disabled="@AllDates" />
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary w-100" @onclick="SearchOrdersAsync" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-search me-2"></i>Search
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
                <button type="button" class="btn-close" @onclick="@(() => ErrorMessage = null)"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@SuccessMessage
                <button type="button" class="btn-close" @onclick="@(() => SuccessMessage = null)"></button>
            </div>
        }

        @if (AllOrders is not null)
        {
            @if (EarlierUnpaidCount > 0 && LoadedStartDate.HasValue)
            {
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span>
                        <strong>@EarlierUnpaidCount</strong> unpaid orders before @LoadedStartDate.Value.ToString("dd.MM.yyyy"),
                        total <strong>@FormatEuro(EarlierNetAmount)</strong>. They are included in "Pay all".
                    </span>
                </div>
            }

            @if (UnpaidUpToEndCount > 0 && HasLoadedRange)
            {
                <div class="card mb-3 border-success">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <span class="fw-semibold">Total due @PayAllScopeText:</span>
                            <span class="fw-bold text-danger fs-5 ms-1">@FormatEuro(TotalDueUpToEnd)</span>
                            <span class="text-muted ms-1">(@UnpaidUpToEndCount orders)</span>
                        </div>
                        <button class="btn btn-success pay-all-button"
                                @onclick="PayAllUnpaidAsync"
                                disabled="@IsProcessing">
                            <i class="bi bi-cash-stack me-2"></i>Pay all unpaid @PayAllScopeText
                        </button>
                    </div>
                </div>
            }

            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <div class="card bg-light">
                                <div class="card-body text-center p-2">
                                    <div class="fw-bold text-primary fs-5">@TotalOrders</div>
                                    <small class="text-muted">Total Orders</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-success bg-opacity-10">
                                <div class="card-body text-center p-2">
                                    <div class="fw-bold text-success fs-5">@PaidOrders</div>
                                    <small class="text-muted">Paid</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-danger bg-opacity-10">
                                <div class="card-body text-center p-2">
                                    <div class="fw-bold text-danger fs-5">@UnpaidOrders</div>
                                    <small class="text-muted">Unpaid</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success bg-opacity-10">
                                <div class="card-body text-center p-2">
                                    <div class="fw-bold text-success fs-5">@FormatEuro(TotalPaid)
                                    </div>
                                    <small class="text-muted">Total Paid Amount</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-danger bg-opacity-10">
                                <div class="card-body text-center p-2">
                                    <div class="fw-bold text-danger fs-5">@FormatEuro(TotalUnpaid)
                                    </div>
                                    <small class="text-muted">Total Unpaid Amount</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-funnel me-1"></i>Filter by Payment Status
                        </label>
                        <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="paymentStatus" id="statusAll" value="All"
                                   checked="@(PaymentStatusFilter == "All")"
                                   @onchange="@(() => PaymentStatusFilter = "All")" />
                            <label class="btn btn-outline-primary" for="statusAll">All (@TotalOrders)</label>

                            <input type="radio" class="btn-check" name="paymentStatus" id="statusUnpaid" value="Unpaid"
                                   checked="@(PaymentStatusFilter == "Unpaid")"
                                   @onchange="@(() => PaymentStatusFilter = "Unpaid")" />
                            <label class="btn btn-outline-danger" for="statusUnpaid">Unpaid (@UnpaidOrders)</label>

                            <input type="radio" class="btn-check" name="paymentStatus" id="statusPaid" value="Paid"
                                   checked="@(PaymentStatusFilter == "Paid")"
                                   @onchange="@(() => PaymentStatusFilter = "Paid")" />
                            <label class="btn btn-outline-success" for="statusPaid">Paid (@PaidOrders)</label>
                        </div>
                    </div>
                </div>
            </div>

            @if (FilteredOrders.Count > 0)
            {
                <div class="card">
                    <div class="card-header bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">
                                <i class="bi bi-list-check me-2"></i>Orders (@FilteredOrders.Count)
                            </span>
                            <div class="d-flex gap-2 align-items-center">
                                <button class="btn btn-sm btn-outline-primary" @onclick="SelectAll">
                                    <i class="bi bi-check-all me-1"></i>Select All Unpaid
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="DeselectAll">
                                    <i class="bi bi-x-lg me-1"></i>Deselect All
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40px;">
                                        <input type="checkbox" class="form-check-input"
                                               checked="@IsAllUnpaidSelected"
                                               @onchange="@(e => ToggleSelectAll(e.Value is true))" />
                                    </th>
                                    <th><i class="bi bi-egg-fried me-1"></i>Meal</th>
                                    <th><i class="bi bi-shop me-1"></i>Supplier</th>
                                    <th><i class="bi bi-calendar-event me-1"></i>Menu Date</th>
                                    <th><i class="bi bi-clock me-1"></i>Ordered At</th>
                                    <th class="text-end"><i class="bi bi-tag me-1"></i>Price</th>
                                    <th class="text-end"><i class="bi bi-percent me-1"></i>Portion</th>
                                    <th class="text-end"><i class="bi bi-cash me-1"></i>Net</th>
                                    <th class="text-center"><i class="bi bi-credit-card me-1"></i>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (UserOrderPaymentItemDto item in FilteredOrders)
                                {
                                    bool isSelected = SelectedOrderIds.Contains(item.OrderId);
                                    bool isPaid = item.PaymentStatus == PaymentStatusDto.Paid;
                                    bool isPayable = IsPayable(item);
                                    decimal estimatedPortion = GetEstimatedPortionForOrder(item);
                                    decimal estimatedNet = GetEstimatedNetForOrder(item);
                                    bool hasPortion = isPaid ? item.PortionApplied : (isSelected && estimatedPortion > 0);
                                    string rowClass = isPaid ? "table-success" : !isPayable ? "table-secondary text-muted" : (isSelected ? "table-primary" : "");

                                    <tr class="@rowClass">
                                        <td>
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@isSelected"
                                                   disabled="@(!isPayable)"
                                                   @onchange="@(e => ToggleOrderSelection(item.OrderId, e.Value is true))" />
                                        </td>
                                        <td class="fw-semibold">@item.MealName</td>
                                        <td>@item.SupplierName</td>
                                        <td><small>@FormatBulgarianDate(item.MenuDate)</small></td>
                                        <td><small>@FormatBulgarianDate(item.OrderedAt)</small></td>
                                        <td class="text-end">@FormatEuro(item.Price)</td>
                                        <td class="text-end">
                                            @if (hasPortion)
                                            {
                                                <span class="text-success fw-bold">-@FormatEuro(estimatedPortion)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold">@FormatEuro(estimatedNet)</td>
                                        <td class="text-center">
                                            @if (isPaid)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Paid
                                                    @if (item.PaidOn.HasValue)
                                                    {
                                                        <small class="d-block">@item.PaidOn.Value.ToString("dd.MM.yyyy")</small>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.PaidByName))
                                                    {
                                                        <small class="d-block paid-by">by @item.PaidByName</small>
                                                    }
                                                </span>
                                            }
                                            else if (item.IsCancelled)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-x-circle me-1"></i>Cancelled
                                                </span>
                                            }
                                            else if (!item.IsCompleted)
                                            {
                                                <span class="badge bg-warning text-dark" title="The menu is not finalized yet; the order cannot be paid.">
                                                    <i class="bi bi-hourglass-split me-1"></i>Pending
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-exclamation-circle me-1"></i>Unpaid
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold">Selected:</span>
                                <span class="badge bg-primary rounded-pill ms-1">@SelectedOrderIds.Count</span>
                                <span class="mx-2">|</span>
                                <span class="fw-bold">Subtotal:</span>
                                <span class="fw-bold ms-1">@FormatEuro(SelectedTotal)</span>
                                @if (EstimatedPortionDeduction > 0)
                                {
                                    <span class="mx-1 text-success">- @FormatEuro(EstimatedPortionDeduction) portion</span>
                                }
                                <span class="mx-2">|</span>
                                <span class="fw-bold">Net total:</span>
                                <span class="fw-bold text-primary fs-5 ms-1">@FormatEuro(EstimatedNetTotal)</span>
                            </div>
                            <button class="btn btn-success px-4" 
                                    @onclick="MarkSelectedAsPaidAsync"
                                    disabled="@(!HasSelection || IsProcessing)">
                                @if (IsProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-2"></i>
                                    <span>Mark as Paid</span>
                                }
                            </button>
                        </div>
                        @if (PortionAmount > 0)
                        {
                            <div class="mt-2 small text-muted">
                                <i class="bi bi-info-circle me-1"></i>Company portion: @FormatEuro(PortionAmount)/day (applied once per day at payment)
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>No orders match the selected filters.
                </div>
            }
        }
    }
</div>
