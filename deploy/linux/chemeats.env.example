# Copy to /etc/chemeats/chemeats.env, fill in, then: chmod 600, chown root:root
# Never commit the filled-in file.

ASPNETCORE_ENVIRONMENT=Production
DOTNET_PRINT_TELEMETRY_MESSAGE=false

# Database (Firebird). Example: DataSource=localhost;Port=3050;Database=/var/lib/firebird/data/CHEMEATS.FDB;User=SYSDBA;Password=...;Charset=UTF8
ConnectionStrings__DefaultConnection=

# JWT: the app issues and validates its own tokens. Use a NEW long random secret (>= 32 chars),
# e.g. `openssl rand -base64 48`. Changing it logs everybody out once.
Jwt__Issuer=ChemEatsWebApi
Jwt__Secret=

# AI menu parsing (leave empty if the isolated host has no internet access)
Groq__ApiKey=
Gemini__ApiKey=
SambaNova__ApiKey=

# SMTP for order reminders (only if the host can reach the mail server)
EmailSettings__UserName=
EmailSettings__Password=

# First admin on an empty database (created on startup if missing)
BootstrapAdmin__Abbreviation=
BootstrapAdmin__FullName=
# Temporary password (min 8 chars, a digit and a lowercase letter); must be changed at first login. Remove after first start.
BootstrapAdmin__Password=

# Log file location (overrides the Windows path in appsettings.Production.json)
Serilog__WriteTo__1__Args__path=/var/log/chemeats/log-.txt
